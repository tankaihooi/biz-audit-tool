# Copy to .env and fill in. .env is gitignored.

# API model key for the baseline engine (OpenAI, Anthropic, etc.)
LLM_API_KEY=your-key-here

# Which engine the backend uses: stub | api | api_no_rag
ENGINE=stub

# Where the FastAPI backend runs (used by the Streamlit frontend)
BACKEND_URL=http://localhost:8000
