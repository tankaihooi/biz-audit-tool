# Copy to .env and fill in. .env is gitignored.

# Gemini API key for the ApiEngine. Free tier, no card required:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: override the default model (gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Which engine the backend uses: stub | api | api_no_rag
ENGINE=stub

# Where the FastAPI backend runs (used by the Streamlit frontend)
BACKEND_URL=http://localhost:8000
